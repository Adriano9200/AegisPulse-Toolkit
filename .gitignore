# Ignorar configurações locais sensíveis, banco de dados SQLite, imagens de disco e chaves de API
config.json
license.json
data/
*.db
*.sqlite
*.sqlite3
*.img
*.bin
*.mapfile.json
*.ddrescue.map

# Ignorar laudos e logs gerados em máquinas de clientes
reports/*.html
reports/*.pdf
logs/*.html
logs/*.log

# Ignorar caches Python e builds de executável
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.spec
.env
.venv/
venv/

# Ignorar arquivos virtuais do Google Drive e backups antigos
*.gdoc
*.gsheet
*.gslides
*.old
*.v1_1_old
*.v2.old
*.v3_0_0.old
