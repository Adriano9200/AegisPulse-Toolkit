# ==============================================================================
# AegisPulse IT Toolkit - .gitignore (v3.0.0)
# Autor: Adriano Barboza (adriano9200@gmail.com | WhatsApp: +55 61 98515-8434)
# ==============================================================================

# Atalhos virtuais do Google Drive
*.gdoc
*.gsheet
*.gslides
*.gdrive
*.old
*.v1_1_old

# Pacotes ZIP de backup
*.zip

# Configuracoes sensiveis locais e Banco de Dados SQLite de Clientes (LGPD)
config.json
.env
data/*.db
data/*.sqlite
data/*.sqlite3

# Relatorios, Orcamentos e Logs de Clientes (NUNCA subir para o GitHub)
reports/*.html
reports/*.json
logs/*.log
logs/*.html
!reports/.gitkeep
!logs/.gitkeep

# Cache do Python e Compilacao PyInstaller
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.spec
.venv/
venv/

# Arquivos temporarios do Sistema Operacional
Thumbs.db
.DS_Store
desktop.ini
